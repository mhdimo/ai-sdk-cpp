{
  "name": "ai-sdk-cpp",
  "version": "1.0.0",
  "description": "Native C++ AI agent framework with Node.js bindings",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node-gyp rebuild && tsc",
    "build:prebuild": "scripts/make-prebuild.sh",
    "install": "node scripts/install.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:only": "node --test test/*.test.cjs",
    "test:live": "node --test test/live/*.test.cjs",
    "prepublishOnly": "node scripts/check-prebuilds.cjs && tsc"
  },
  "files": [
    "dist/",
    "prebuilds/",
    "scripts/install.cjs"
  ],
  "dependencies": {
    "node-addon-api": "^7.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "node-gyp": "^10.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhdimo/ai-sdk-cpp.git",
    "directory": "bindings/node"
  },
  "homepage": "https://github.com/mhdimo/ai-sdk-cpp#readme",
  "bugs": {
    "url": "https://github.com/mhdimo/ai-sdk-cpp/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "agent",
    "anthropic",
    "openai",
    "tool-calling",
    "napi"
  ],
  "license": "MIT"
}
