# Build directories
build/
_deps/
.cache/
# scripts/coverage.sh's instrumented tree (it is not covered by `build/` above).
build-coverage/

# CMake generated files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
DartConfiguration.tcl
Makefile
compile_commands.json

# Build artifacts
*.a
*.o
*.so
*.dylib
*.dll

# Coverage profiles (LLVM_PROFILE_FILE / llvm-profdata output)
*.profraw
*.profdata

# macOS
.DS_Store
build_py/

# Python
*.egg-info/
__pycache__/
*.pyc
*.pyo

# Node
node_modules/
bindings/node/dist/
# Per-platform binaries produced by bindings/node/scripts/make-prebuild.sh.
# Built by .github/workflows/prebuilds.yml and assembled at publish time; they
# are several megabytes per platform and do not belong in the repository.
prebuilds/
# make-prebuild.sh's C++ build tree (not covered by `build/` above).
build-prebuild/

# Secrets — API keys for live tests are read from the environment, never a file
.env
.env.*
!.env.example
